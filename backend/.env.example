TRIKMED_AUTH_SECRET=dev-only-change-me
TRIKMED_TOKEN_TTL_SECONDS=604800

SUPABASE_URL=
# Preferred for new Supabase projects/API keys. Keep server-side only.
SUPABASE_SECRET_KEY=
# Legacy fallback. Use only until migrated from JWT service_role keys.
SUPABASE_SERVICE_ROLE_KEY=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Production CORS — comma-separated list of your deployed frontend URLs
# e.g. https://trikmed.up.railway.app,https://trikmed.vercel.app
ALLOWED_ORIGINS=

WHATSAPP_NUMBER=
PUBLIC_BASE_URL=http://localhost:8000

# Demo Data Bootstrap Variables
TRIKMED_DEMO_MODE=true
BOOTSTRAP_DEMO_DATA=true
DEMO_CLINIC_ADMIN_EMAIL=clinicadmin@trikmed.example
DEMO_CLINIC_ADMIN_PASSWORD=your_secure_password_here
DEMO_DOCTOR_PASSWORD=your_secure_password_here
DEMO_STAFF_PASSWORD=your_secure_password_here


TRIKMED_STORAGE=json
TRIKMED_DEV_SHORTCUTS=true

# Voice Rx — keep this key only in backend/.env, never in the frontend.
OPENAI_API_KEY=
AI_SPEECH_PROVIDER=openai
AI_LLM_PROVIDER=openai
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini
SEMANTIC_THRESHOLD=0.80

# Drug reference (CDCI). Deployed: Supabase DIRECT Postgres connection string (Settings -> Database).
DATABASE_URL=
# Local development without a database: path to the unzipped CDCI Flat Files folder.
CDCI_FOLDER=
